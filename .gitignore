# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv-ssc

# Downloaded structures (rebuilt by scripts/01_dataset.py)
structures/
data/

# Per-residue embeddings (~380 GB, rebuilt by scripts/02_extract.py), run logs and scratch
# runs stay out. Everything else under results/ is small derived output and is tracked:
# see results/README.md.
results/esm/
results/esm650/
results/esm1v_s1/
results/esm1v_s2/
results/rand_esm/
results/carp/
results/proteinmpnn/
results/rand_mpnn/
results/esmif1/
results/*.log
results/_verify_merge/
results/stitch_test/
results/stitching_test/

# Page builder output (regenerated by site/build.sh)
site/build/

# Hugging Face dataset build (scripts/07_hf_dataset.py; published to the Hub)
hf/

# Local test directories (safe to delete at any time)
results_test/
structures_test/

# Model weight caches (should live under HF_HOME on /scratch, never in-repo)
*.pt
*.ckpt

# API keys / tokens -- never commit
api_keys.py
notebooks/api_keys.py
*.token

# Per-environment data symlinks created for the notebooks
notebooks/results
notebooks/structures

# Jupyter auto-save checkpoints
.ipynb_checkpoints/

# Claude Code worktrees
.claude/

# paper/ holds private working notes and is never tracked
paper/

# research/ is public: it holds the literature review.

# Local agent config -- machine-specific, references co-located projects
CLAUDE.md
